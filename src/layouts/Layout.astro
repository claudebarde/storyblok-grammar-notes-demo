---
const { title = "Modern Sumerian Grammar Notes" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f1e9" />
    <meta name="description" content="Clear, detailed notes on Sumerian grammar." />
    <title>{title} · Grammar Notes</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Modern Sumerian Grammar Notes home">
        <span class="brand-mark">𒀭</span>
        <span>FIELD NOTES <small>SUMERIAN GRAMMAR</small></span>
      </a>
      <span class="header-note">An evolving reference</span>
    </header>
    <slot />
    <footer class="site-footer">
      <a href="/">Modern Sumerian Grammar Notes</a>
      <span>Built with Storyblok · Content stays editable</span>
    </footer>
  </body>
</html>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Literata:opsz,wght@7..72,400;7..72,500;7..72,600;7..72,700&display=swap");

  :root {
    color-scheme: light;
    --ink: #1e2925;
    --muted: #69736d;
    --paper: #f4f1e9;
    --card: #fffdf8;
    --line: #dcded4;
    --green: #526b55;
    --rust: #a65e40;
    font-family: "DM Sans", sans-serif;
    background: var(--paper);
    color: var(--ink);
  }

  * { box-sizing: border-box; }
  body { margin: 0; min-width: 320px; }
  a { color: inherit; }
  .site-header, .site-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem clamp(1.25rem, 5vw, 5rem);
    border-bottom: 1px solid var(--line);
  }
  .brand { display: inline-flex; align-items: center; gap: .75rem; text-decoration: none; font: 500 .75rem "DM Mono", monospace; letter-spacing: .08em; }
  .brand small { display: block; margin-top: .25rem; color: var(--muted); font-size: .58rem; letter-spacing: .16em; }
  .brand-mark { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border: 1px solid var(--line); border-radius: 50%; color: var(--rust); font-size: 1.2rem; }
  .header-note, .site-footer span { color: var(--muted); font: .72rem "DM Mono", monospace; letter-spacing: .03em; }
  .site-main { width: min(1120px, calc(100% - 2.5rem)); margin: 0 auto; padding: clamp(3rem, 8vw, 7rem) 0; }
  .eyebrow { color: var(--rust); font: 500 .7rem "DM Mono", monospace; letter-spacing: .16em; text-transform: uppercase; }
  .listing-heading { max-width: 760px; margin-bottom: 3.25rem; }
  h1, h2, h3 { font-family: "Literata", Georgia, serif; font-weight: 500; letter-spacing: -.035em; }
  .listing-heading h1, .article-title, .not-found h1 { margin: .65rem 0 1rem; font-size: clamp(2.5rem, 6vw, 5rem); line-height: 1.03; }
  .listing-intro { max-width: 620px; color: var(--muted); font: 1.08rem/1.7 "Literata", Georgia, serif; }
  .article-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.15rem; }
  .article-card { overflow: hidden; border: 1px solid var(--line); border-radius: 5px; background: var(--card); transition: transform .2s ease, box-shadow .2s ease; }
  .article-card:hover { transform: translateY(-3px); box-shadow: 0 14px 36px #202a2412; }
  .article-card a { display: block; height: 100%; text-decoration: none; }
  .card-cover { display: grid; place-items: center; aspect-ratio: 16 / 8; overflow: hidden; background: linear-gradient(135deg, #d9dfcf, #ebe5d8 54%, #d4d8cd); color: #60705e; }
  .card-cover img { width: 100%; height: 100%; object-fit: cover; }
  .cover-placeholder { font: 500 2rem "Literata", Georgia, serif; opacity: .7; }
  .card-copy { padding: 1.4rem 1.5rem 1.6rem; }
  .card-category { color: var(--rust); font: 500 .66rem "DM Mono", monospace; letter-spacing: .14em; text-transform: uppercase; }
  .card-copy h2 { margin: .65rem 0 .55rem; font-size: clamp(1.35rem, 3vw, 1.8rem); line-height: 1.18; }
  .card-copy p { max-width: 48ch; margin: 0; color: var(--muted); font: .95rem/1.65 "Literata", Georgia, serif; }
  .read-link { display: inline-block; margin-top: 1.1rem; color: var(--green); font: 500 .72rem "DM Mono", monospace; text-transform: uppercase; letter-spacing: .08em; }
  .site-main--article { max-width: 880px; }
  .article-title { max-width: 780px; margin-bottom: 2rem; }
  .article-banner { width: 100%; max-height: 480px; margin: 0 0 2.5rem; border-radius: 4px; object-fit: cover; }
  .article-summary { margin: 0 0 2.5rem; padding-left: 1.2rem; border-left: 2px solid var(--rust); color: var(--muted); font: 1.2rem/1.65 "Literata", Georgia, serif; }
  .markdown-body { font: 1rem/1.8 "Literata", Georgia, serif; overflow-wrap: anywhere; }
  .markdown-body h1, .markdown-body h2, .markdown-body h3, .markdown-body h4 { margin: 2.3em 0 .7em; line-height: 1.2; }
  .markdown-body h1 { font-size: 2.25rem; }
  .markdown-body h2 { padding-bottom: .45rem; border-bottom: 1px solid var(--line); font-size: 1.8rem; }
  .markdown-body h3 { font-size: 1.35rem; }
  .markdown-body p, .markdown-body ul, .markdown-body ol, .markdown-body blockquote, .markdown-body table, .markdown-body pre { margin: 1.1em 0; }
  .markdown-body a { color: var(--green); text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .markdown-body blockquote { margin-left: 0; padding: .25rem 1rem; border-left: 2px solid #aeb8a8; color: #58645c; }
  .markdown-body code { padding: .08em .28em; border-radius: 3px; background: #e8e8df; font: .84em "DM Mono", monospace; }
  .markdown-body pre { overflow-x: auto; padding: 1rem; border-radius: 4px; background: #202b26; color: #f4f1e9; line-height: 1.6; }
  .markdown-body pre code { padding: 0; background: none; color: inherit; }
  .markdown-body table { display: block; width: 100%; overflow-x: auto; border-collapse: collapse; font-size: .88rem; }
  .markdown-body th, .markdown-body td { padding: .55rem .7rem; border: 1px solid var(--line); text-align: left; }
  .markdown-body th { background: #e9e9df; font-family: "DM Sans", sans-serif; }
  .markdown-body hr { margin: 2.2rem 0; border: 0; border-top: 1px solid var(--line); }
  .markdown-body img { max-width: 100%; height: auto; }
  .not-found { min-height: 65vh; }
  .site-footer { border-top: 1px solid var(--line); border-bottom: 0; }
  .site-footer a { font: 500 .72rem "DM Mono", monospace; text-decoration: none; }
  @media (max-width: 700px) {
    .article-grid { grid-template-columns: 1fr; }
    .site-header, .site-footer { padding-inline: 1.25rem; }
    .header-note { display: none; }
    .site-footer { align-items: flex-start; flex-direction: column; }
  }
</style>
